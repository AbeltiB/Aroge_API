# Copy this file to .env.test — tests/setup.ts loads it before any app code
# is imported, so these values win over whatever's in .env (dotenv doesn't
# override already-set vars). Values below are dummy/local by design: no test
# in this suite calls a real Telegram/MinIO/verify.et API — the payment
# gateways (see src/lib/payments/) are fully local, and anything that touches
# a real provider is out of the current test scope (see tests/README.md).

# Same Postgres container as local dev (docker-compose.yml, port 5433), but a
# separate database — tests/setup.ts truncates every table before each test,
# which would be destructive against the real "aroge" dev database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aroge_test
REDIS_URL=redis://localhost:6380

NODE_ENV=test

JWT_ACCESS_SECRET=test_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_characters_long_x

TELEGRAM_BOT_TOKEN=test:not-a-real-bot-token
TELEGRAM_BOT_USERNAME=aroge_test_bot

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=test-not-used
MINIO_SECRET_KEY=test-not-used
IMGPROXY_URL=http://localhost:8080

# Dummy — the search route test mocks src/lib/meilisearch.ts entirely rather
# than hitting a real Meilisearch instance. Every other test file still
# needs these to be non-empty strings to satisfy env.ts's Zod schema.
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=test-not-used
