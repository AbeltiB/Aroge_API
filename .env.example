# Copy this file to .env and fill in your values
# Generate JWT secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Database ─────────────────────────────────────────────────────────────────
# Local Docker (see docker-compose.yml — mapped to 5433 to avoid clashing with
# other local Postgres instances on the default port):
# postgresql://postgres:postgres@localhost:5433/aroge
# Production: Neon (neon.tech) free tier — copy the DIRECT connection string
# from your Neon project dashboard (NOT the "-pooler" one; this app keeps its
# own small long-lived Prisma pool, so PgBouncer's transaction pooling isn't
# needed and adds a prepared-statement caveat with Prisma if used).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aroge

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker (mapped to 6380, see docker-compose.yml): redis://localhost:6380
# Production: Upstash (upstash.com) free tier — copy the "rediss://" TLS
# connection string from the Upstash console (not the REST API URL).
REDIS_URL=redis://localhost:6380

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret

# ── Telegram (the only auth mechanism — see login widget setup in the README) ─
# @BotFather → /newbot → copy the token. The bot's numeric ID/username also
# drive the Telegram Login Widget on web (admin) and the OAuth flow on mobile.
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=ArogeBot

# One-time owner bootstrap: set this to your numeric Telegram user ID (get it
# from @userinfobot) before running `npm run prisma:seed` to auto-provision
# yourself as SUPER_ADMIN + a fully-trusted mobile user. Safe to unset after.
OWNER_TELEGRAM_ID=

# ── Cloudinary ────────────────────────────────────────────────────────────────
# https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Payment gateways (fill when API access is granted) ────────────────────────
TELEBIRR_API_URL=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
CBE_BIRR_API_URL=
CBE_BIRR_MERCHANT_ID=

# ── verify.et bank-transfer reference verification ────────────────────────────
# https://verify.et → Dashboard → API Keys (needs verification:read + verification:write)
# Leave unset to fall back to manual proof-photo review (already built).
VERIFY_ET_API_KEY=
VERIFY_ET_BASE_URL=https://verify.et
# REQUIRED whenever VERIFY_ET_API_KEY is set — without it, POST
# /payments/webhook/verify-et has no authentication and a buyer could forge a
# "paid" webhook call for their own verifyRequestId. Set the same secret in
# your verify.et webhook config.
VERIFY_ET_WEBHOOK_SECRET=

# ── Keep-alive ────────────────────────────────────────────────────────────────
# Point an uptime monitor (e.g. UptimeRobot, free tier) at:
#   GET https://<your-api>/warm?key=<this value>
# every ~10 min. Unlike /health (liveness only), this touches Postgres+Redis,
# which is what actually prevents Neon/Upstash's own free-tier cold starts —
# not just Render's process-level sleep. Leave unset locally; generate a
# random value for production: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WARM_PING_SECRET=
